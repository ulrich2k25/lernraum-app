generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lernraum {
  id                  Int        @id @default(autoincrement())
  raumBezeichnung     String
  gebaeude            String
  etage               String
  kapazitaet          Int
  status              RaumStatus @default(ACTIVE)
  raumToken           String     @unique
  autoCloseWhenEmpty  Boolean    @default(false)
  isTemporarilyClosed Boolean    @default(false)

  sessions Session[]
}

model Session {
  id             Int           @id @default(autoincrement())
  clientId       String
  lernraumId     Int
  status         SessionStatus @default(ACTIVE)
  startedAt      DateTime      @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  reminderSentAt DateTime?
  groupSize      Int           @default(1)

  lernraum Lernraum @relation(fields: [lernraumId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([lernraumId, status])
  @@index([expiresAt, status])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  clientId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}
model ClientIdentity {
  clientId   String   @id
  secretHash String
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum RaumStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}
model Feedback {
  id        Int          @id @default(autoincrement())
  rating    FeedbackRating
  message   String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

enum FeedbackRating {
  POSITIVE
  NEGATIVE
}